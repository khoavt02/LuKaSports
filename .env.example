# Copy this file to .env and adjust values before running docker compose.

# --- Ports (host side) ---
WP_PORT=8090
PHPMYADMIN_PORT=8091
DB_PORT=3308

# --- Database ---
MYSQL_DATABASE=linea
MYSQL_USER=linea
MYSQL_PASSWORD=linea_dev_password
MYSQL_ROOT_PASSWORD=linea_root_password

# --- WordPress ---
WP_TABLE_PREFIX=wp_
WP_DEBUG=true

# --- Site identity used by the seed script (bin/seed-products.php) ---
WP_SITE_TITLE=LukaSports
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_dev_password
WP_ADMIN_EMAIL=dev@example.com
