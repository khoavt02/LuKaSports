{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#1A1A1A" },
				{ "slug": "navy", "name": "Ink", "color": "#1A1A1A" },
				{ "slug": "paper", "name": "Paper", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F7F5F1" },
				{ "slug": "line", "name": "Line", "color": "#E6E1D6" },
				{ "slug": "muted", "name": "Muted text", "color": "#837C70" },
				{ "slug": "accent", "name": "Accent (DALETIC Blue)", "color": "#146EF5" }
			],
			"custom": false,
			"customGradient": false
		},
		"typography": {
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.75rem" },
				{ "slug": "sm", "name": "SM", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "lg", "name": "LG", "size": "1.125rem" },
				{ "slug": "xl", "name": "XL", "size": "1.375rem" },
				{ "slug": "2xl", "name": "2XL", "size": "1.75rem" },
				{ "slug": "3xl", "name": "3XL", "size": "2.25rem" },
				{ "slug": "4xl", "name": "4XL", "size": "2.75rem" }
			],
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "-apple-system, 'Helvetica Neue', 'Segoe UI', Roboto, Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "-apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				}
			],
			"customFontSize": false
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "1", "name": "1", "size": "0.25rem" },
				{ "slug": "2", "name": "2", "size": "0.5rem" },
				{ "slug": "3", "name": "3", "size": "0.75rem" },
				{ "slug": "4", "name": "4", "size": "1rem" },
				{ "slug": "6", "name": "6", "size": "1.5rem" },
				{ "slug": "8", "name": "8", "size": "2rem" },
				{ "slug": "12", "name": "12", "size": "3rem" },
				{ "slug": "16", "name": "16", "size": "4rem" }
			]
		},
		"layout": {
			"contentSize": "1240px",
			"wideSize": "1400px"
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#1A1A1A"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body"
		},
		"elements": {
			"link": {
				"color": { "text": "#A6813F" }
			},
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|display" }
			}
		}
	}
}
